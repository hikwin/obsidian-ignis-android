<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部 Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_ignis_logo"
                android:contentDescription="Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/obsidian_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Obsidian 本地 Web 运行环境"
                    android:textColor="@color/obsidian_text_sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnGithub"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_github"
                android:contentDescription="GitHub"
                app:tint="@color/obsidian_text_sub" />

        </LinearLayout>

        <!-- 卡片 1：Web 本地服务管理 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/obsidian_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/obsidian_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/shape_dot_stopped" />

                    <TextView
                        android:id="@+id/tvServerStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/server_stopped"
                        android:textColor="@color/obsidian_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="端口:"
                        android:textColor="@color/obsidian_text_sub"
                        android:textSize="13sp"
                        android:layout_marginEnd="6dp" />

                    <EditText
                        android:id="@+id/etPort"
                        android:layout_width="64dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_input_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="8080"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 访问安全与验证码配置 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="访问码:"
                        android:textColor="@color/obsidian_text_sub"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etAccessCode"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_box"
                        android:paddingHorizontal="10dp"
                        android:hint="留空则直接访问 (免密)"
                        android:textColorHint="@color/obsidian_text_sub"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp"
                        android:inputType="text"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- 地址列表容器 -->
                <LinearLayout
                    android:id="@+id/layoutAddresses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_box"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="局域网 Wi-Fi 访问地址 (电脑/平板访问):"
                        android:textColor="@color/obsidian_text_sub"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLanUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="http://127.0.0.1:8080/"
                        android:textColor="@color/obsidian_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                </LinearLayout>

                <!-- 启动/停止服务按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleServer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_start_server"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/obsidian_primary"
                    app:cornerRadius="10dp" />

                <!-- 在应用内打开 Obsidian 按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAppWebview"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_open_webview"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/obsidian_accent"
                    app:cornerRadius="10dp" />

                <!-- 辅助快捷按钮（复制与外部浏览器打开） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyLanUrl"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="复制地址"
                        android:textColor="@color/obsidian_text"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/obsidian_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenExternalBrowser"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="外部浏览器"
                        android:textColor="@color/obsidian_text"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/obsidian_border" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片 2：Obsidian 官方核心资源管理 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/obsidian_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/obsidian_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_title"
                    android:textColor="@color/obsidian_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前核心版本: "
                        android:textColor="@color/obsidian_text_sub"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCoreVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未安装"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCorePath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="存储目录: app_files/obsidian_assets"
                    android:textColor="@color/obsidian_text_sub"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadCore"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_download_core"
                    android:textColor="@color/obsidian_accent"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/obsidian_accent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片 3：Ignis 适配组件与补丁 (Web Shims) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/obsidian_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/obsidian_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ignis 适配组件 (Web Shims)"
                    android:textColor="@color/obsidian_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前组件版本: "
                        android:textColor="@color/obsidian_text_sub"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvIgnisVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v0.8.17 (内置)"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="支持 Obsidian 版本: "
                        android:textColor="@color/obsidian_text_sub"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvIgnisSupportedObsidian"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.14.4"
                        android:textColor="@color/obsidian_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateIgnisShims"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="🔄 更新 Ignis 组件"
                    android:textColor="@color/obsidian_accent"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/obsidian_accent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片 4：知识库 (Vaults) 管理 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/obsidian_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/obsidian_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/vault_title"
                        android:textColor="@color/obsidian_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageVaults"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:text="🗂️ 管理库"
                        android:textColor="@color/obsidian_text_sub"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenLocalVault"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:text="📂 打开本地"
                        android:textColor="@color/obsidian_accent"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVaultInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="当前默认知识库: DefaultVault"
                    android:textColor="@color/obsidian_text"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spVaults"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_box"
                    android:popupBackground="@color/obsidian_card" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
