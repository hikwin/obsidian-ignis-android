<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/obsidian_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📁 新建知识库 (Vault)"
        android:textColor="@color/obsidian_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="请输入新知识库文件夹名称（支持中英文）："
        android:textColor="@color/obsidian_text_sub"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etVaultName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_box"
        android:hint="例如: 工作笔记、读书心得"
        android:textColorHint="@color/obsidian_text_sub"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="@color/obsidian_text"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelVault"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textColor="@color/obsidian_text_sub" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmVault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="立即创建"
            android:textColor="@color/white"
            app:backgroundTint="@color/obsidian_primary" />
    </LinearLayout>

</LinearLayout>
