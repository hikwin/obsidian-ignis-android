<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/obsidian_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📥 下载 / 更新 Obsidian 核心"
        android:textColor="@color/obsidian_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="从官方 Releases 下载 asar.gz 核心包并自动解压部署至本地。"
        android:textColor="@color/obsidian_text_sub"
        android:textSize="12sp" />

    <!-- 版本选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="目标版本:"
        android:textColor="@color/obsidian_text"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spVersion"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_box"
        android:popupBackground="@color/obsidian_card" />

    <!-- 镜像加速源选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="下载源 / 镜像加速:"
        android:textColor="@color/obsidian_text"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spMirror"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_box"
        android:popupBackground="@color/obsidian_card" />

    <!-- 进度与日志展示 -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/obsidian_primary" />

        <TextView
            android:id="@+id/tvProgressStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="准备中..."
            android:textColor="@color/obsidian_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_box"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:textColor="@color/obsidian_text_sub"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textColor="@color/obsidian_text_sub" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="开始下载并解压"
            android:textColor="@color/white"
            app:backgroundTint="@color/obsidian_primary" />
    </LinearLayout>

</LinearLayout>
